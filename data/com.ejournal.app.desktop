[Desktop Entry]
Type=Application
Name=E-Journal
GenericName=Ink Notebook
Comment=Local-first ink notebook for handwriting and note taking
Exec=e-journal %F
Icon=com.ejournal.app
Terminal=false
Categories=Office;Utility;
Keywords=notes;notebook;ink;handwriting;pen;journal;whiteboard;
StartupWMClass=E-Journal
StartupNotify=true
MimeType=application/x-ejournal;